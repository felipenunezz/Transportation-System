<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Bus Transport System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css"/>
    <link rel="stylesheet" href="/app.css" asp-append-version="true"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>
<body>
<div class="d-flex">
    <aside id="sidebar-root"></aside>

    <div class="flex-grow-1">
        <div class="container-fluid mt-3">
            @RenderBody()
        </div>
    </div>
</div>
<script src="/js/Site/injectModal.js"></script>
<partial name="_ValidationScriptsPartial" />
<script src="/js/routeStopQueue.js"></script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/Bootstrap-Items/sidebar.js"></script>
<script>
    renderSidebar('#sidebar-root');
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>