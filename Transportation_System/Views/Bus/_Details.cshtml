@using Transportation_System.Models.Domain
@model Transportation_System.Models.Domain.Bus
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Details";
}

<div class="mb-3 text-center">
    <i class="bi bi-info-circle text-info fa-2x"></i>
</div>

<dl class="row">
    <dt class="col-sm-4 text-muted">
        <i class="bi bi-hash me-1"></i>Bus Number
    </dt>
    <dd class="col-sm-8 fw-semibold">@Html.DisplayFor(model => model.BusNumber)</dd>

    <dt class="col-sm-4 text-muted d-flex">
        <i class="bi bi-signpost-2 me-1"></i>Route
    </dt>
    <dd class="col-sm-8 fw-semibold">
        @if (Model.OnRoute)
        {
            @Html.DisplayFor(model => model.Route!.Name)
        }
        else {<span>Currently off route</span>}
    </dd>
    
    <dt class="col-sm-4 text-muted">
        <i class="bi bi-geo-alt me-1"></i>Current Stop
    </dt>
    <dd class="col-sm-8 fw-semibold">
        @if (Model is { Status: BusStatus.AtStop, StopId: not null })
        {
            @Html.DisplayFor(model => model.Stop!.Name)
        }
        else {<span>Moving</span>} 
    </dd>
    <dt class="col-sm-4 text-muted">
        <i class="bi bi-globe me-1"></i>Location
    </dt>
    
    <dd class="col-sm-8">
        <input type="hidden" asp-for="CurrentLatitude" id="Latitude" />
        <input type="hidden" asp-for="CurrentLongitude" id="Longitude" />
        <input type="hidden" value="false" id="EnableSelection" />
        
        <div id="selectionMap" style="height: 250px; border-radius: 0.375rem; z-index: 0; width: 100%;" data-enable-selection="false"></div>
        <div class="form-text text-muted mt-1">
            Lat: <span id="displayLat">--</span>, Lng: <span id="displayLng">--</span>
        </div>
    </dd>

    <dt class="col-sm-4 text-muted">
        <i class="bi bi-speedometer2 me-1"></i>Speed
    </dt>
    <dd class="col-sm-8">@Html.DisplayFor(model => model.Speed)</dd>

    <dt class="col-sm-4 text-muted">
        <i class="bi bi-people me-1"></i>Passengers
    </dt>
    <dd class="col-sm-8">@Html.DisplayFor(model => model.PassengerCount)</dd>

    <dt class="col-sm-4 text-muted">
        <i class="bi bi-circle-fill me-1"></i>Status
    </dt>
    <dd class="col-sm-8">@Html.DisplayFor(model => model.Status)</dd>
    
    <dt class="col-sm-4 text-muted">
        <i class="fa-regular fa-route"></i>On Route
    </dt>
    <dd class="col-sm-8">
        @if (Model.OnRoute)
        {
            <span class="badge bg-success">On Route</span>
        }
        else
        {
            <span class="badge bg-secondary">Off Route</span>
        }
    </dd>


    <dt class="col-sm-4 text-muted">
        <i class="bi bi-clock me-1"></i>Last Update
    </dt>
    <dd class="col-sm-8">@Html.DisplayFor(model => model.LastUpdate)</dd>
</dl>