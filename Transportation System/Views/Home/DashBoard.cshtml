@using Transportation_System.Models.Domain

@{
    Layout = "_Layout";
    ViewData["Title"] = "Live Bus Tracking Dashboard";
    var buses = ViewBag.ActiveBuses as List<Bus>;
    var stops = ViewBag.BusStops as List<BusStop>;
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1>🚌 Live Bus Tracking</h1>
            <p class="text-muted">Real-time monitoring of bus fleet</p>
        </div>
    </div>
    
    <div class="row">
        <!-- Map Section -->
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5>Live Map View</h5>
                </div>
                <div class="card-body p-0">
                    <div id="map" style="height: 600px;"></div>
                </div>
            </div>
        </div>
        
        <!-- Bus List Section -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5>Active Buses</h5>
                </div>
                <div class="card-body">
                    <div id="bus-list">
                        @foreach (var bus in buses)
                        {
                            <div class="card mb-2 bus-card" data-bus-id="@bus.Id">
                                <div class="card-body">
                                    <h6>@bus.BusNumber</h6>
                                    <small>Route: @bus.BusRouteName</small><br/>
                                    <small>Status: <span class="badge bg-success">@bus.Status</span></small>
                                    <br/>
                                    <small>Speed: <span class="speed">@bus.Speed</span> km/h</small>
                                    <br/>
                                    <small>Passengers: @bus.PassengerCount</small>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            
            <!-- Quick Links -->
            <div class="card mt-3">
                <div class="card-header">
                    <h5>Management</h5>
                </div>
                <div class="card-body">
                    <a asp-controller="Buses" asp-action="Index" class="btn btn-primary btn-block mb-2">Manage Buses</a>
                    <a asp-controller="BusStops" asp-action="Index" class="btn btn-secondary btn-block mb-2">Manage Stops</a>
                    <a asp-controller="Routes" asp-action="Index" class="btn btn-info btn-block">Manage Routes</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script src="~/js/map.js"></script>
    <script src="~/js/dashboard.js"></script>
}