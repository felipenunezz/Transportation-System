@model Transportation_System.Models.Domain.BusRoute

<div class="mb-3 text-center">
    <i class="bi bi-info-circle text-info fa-2x"></i>
</div>

<dl class="row">
    <dt class="col-sm-4 text-muted">
        <i class="bi bi-tag me-1"></i>Name
    </dt>
    <dd class="col-sm-8 fw-semibold">@Html.DisplayFor(model => model.Name)</dd>

    <dt class="col-sm-4 text-muted">
        <i class="bi bi-card-text me-1"></i>Description
    </dt>
    <dd class="col-sm-8">@Html.DisplayFor(model => model.Description)</dd>

    <dt class="col-sm-4 text-muted">
        <i class="bi bi-circle-fill me-1"></i>Status
    </dt>
    <dd class="col-sm-8">
        @if (Model.IsActive)
        {
            <span class="badge bg-success">Active</span>
        }
        else
        {
            <span class="badge bg-secondary">Inactive</span>
        }
    </dd>
</dl>