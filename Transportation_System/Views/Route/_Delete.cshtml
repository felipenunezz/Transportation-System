@model Transportation_System.Models.Domain.Route
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="text-center mb-3">
    <i class="fa-solid fa-triangle-exclamation text-danger fa-3x"></i>
</div>

<dl class="row mb-4">
    <dt class="col-sm-4 text-muted">
        <i class="bi bi-tag me-1"></i>Name
    </dt>
    <dd class="col-sm-8 fw-semibold">@Html.DisplayFor(model => model.Name)</dd>

    <dt class="col-sm-4 text-muted">
        <i class="bi bi-card-text me-1"></i>Description
    </dt>
    <dd class="col-sm-8">@Html.DisplayFor(model => model.Description)</dd>

    <dt class="col-sm-4 text-muted">
        <i class="bi bi-circle-fill me-1"></i>Status
    </dt>
    <dd class="col-sm-8">
        @if (Model.IsActive)
        {
            <span class="badge bg-success">Active</span>
        }
        else
        {
            <span class="badge bg-secondary">Inactive</span>
        }
    </dd>
    
    <dt class ="col-sm-4 text-muted">
        <i class="bi bi-list-ol me-1"></i> Stops
    </dt>
    
    <dd class ="col-sm-8">
        @{ var stops = (List<Transportation_System.Models.Domain.Stop>)ViewBag.OrderedStops;}
        @for (int i = 0; i < stops.Count; i++)
        {
            <li class="list-group-item d-flex justify-content-between align-items-md-start" datas-stop-id="@stops[i].Id">
                <span><span class="text-muted me-2">@(i + 1).</span>@stops[i].Name</span>
            </li>
        }
        @if (!stops.Any()) { <li class = "list-group-item text-muted">No stops on this route yet.</li>}
    </dd>
</dl>

<form asp-action="Delete" method="post" id="deleteForm" class="ajax-form">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div class="d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
            <i class="bi bi-x-lg me-1"></i>Cancel
        </button>
        <button type="submit" class="btn btn-danger">
            <i class="fa-solid fa-trash-can me-1"></i>Delete
        </button>
    </div>
</form>