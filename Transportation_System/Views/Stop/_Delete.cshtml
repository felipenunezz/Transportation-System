@using Transportation_System.Models.Domain
@model Transportation_System.Models.Domain.Stop
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Delete";
}

<div class="text-center mb-3">
    <i class="fa-solid fa-triangle-exclamation text-danger fa-3x"></i>
</div>

<dl class="row mb-4">
    <dt class="col-sm-4 text-muted">
        <i class="bi bi-tag me-1"></i>Stop Name
    </dt>
    <dd class="col-sm-8 fw-semibold">@Html.DisplayFor(model => model.Name)</dd>

    <dt class="col-sm-4 text-muted">
        <i class="bi bi-geo-alt me-1"></i>Address
    </dt>
    <dd class="col-sm-8">@Html.DisplayFor(model => model.Address)</dd>
    
    <dt class="col-sm-4 text-muted">
        <i class="bi bi-globe me-1"></i>Location
    </dt>
    
    <input type="hidden" asp-for="Latitude" id="Latitude"/>
    <input type="hidden" asp-for="Longitude" id="Longitude"/>
    
    <dd class="col-sm-8">    
        <div id="selectionMap" style="height: 250px; border-radius: 0.375rem; z-index: 0;" data-enable-selection="false"></div>
        <div class="form-text text-muted mt-1">
            Lat: <span id="displayLat">--</span>, Lng: <span id="displayLng">--</span>
        </div>
    </dd>
    
    @if (Model.Type != StopType.Depot)
    {
        <dt class="col-sm-4 text-muted">
            <i class="bi bi-people me-1"></i>Waiting
        </dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.WaitingPassengers)</dd>

        <dt class="col-sm-4 text-muted">
            <i class="bi bi-signpost-2 me-1"></i>Route
        </dt>
        <dd class="col-sm-8">@Html.DisplayFor(model => model.Route.Name)</dd>
    }
</dl >

<form asp-action="Delete" method="post" id="deleteForm" class="ajax-form">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div class="d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
            <i class="bi bi-x-lg me-1"></i>Cancel
        </button>
        <button type="submit" class="btn btn-danger">
            <i class="fa-solid fa-trash-can me-1"></i>Delete
        </button>
    </div>
</form>