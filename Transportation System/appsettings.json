{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Transportation System": "Debug"
    }
  },
  "AllowedHosts": "*",
  "MqttSettings": {
    "BrokerAddress": "broker.hivemq.com",
    "BrokerPort": 1883,
    "ClientId": "TransportTDashboard",
    "Topics": [
      "metro/+/trains",
      "taxi/+/taxis"
    ]
  },
  "DatabaseSettings": { 
    "UseInMemoryDatabase": true
  }
}