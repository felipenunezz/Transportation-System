@using Transportation_System.Models.Domain
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "_Layout";
    ViewData["Title"] = "Live Bus Tracking Dashboard";
    var buses = ViewBag.ActiveBuses as List<Bus>;
    var stops = ViewBag.BusStops as List<BusStop>;
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1>🚌 Live Bus Tracking</h1>
            <p class="text-muted">Real-time monitoring of bus fleet</p>
        </div>
    </div>
    
    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h5>Live Map View</h5>
                </div>
                <div class="card-body p-0">
                    <div id="map" style="height: 600px;"></div>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5>Active Buses</h5>
                </div>
                <div class="card-body">
                    <div id="bus-list">
                        @if (buses != null && buses.Any())
                        {
                            foreach (var bus in buses)
                            {
                                <div class="card mb-2 bus-card" data-bus-id="@bus.Id">
                                    <div class="card-body">
                                        <h6>@bus.BusNumber</h6>
                                        <small>Route: @bus.BusRouteId</small><br/>
                                        <small>Status: <span class="badge bg-success">@bus.Status</span></small>
                                        <br/>
                                        <small>Speed: <span class="speed">@bus.Speed</span> km/h</small>
                                        <br/>
                                        <small>Passengers: <span class="passengers">@bus.PassengerCount</span></small>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p>No active buses at the moment.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
        window.__dashboardData = {
            busStops: @Html.Raw(Json.Serialize(ViewBag.BusStops))
        };
    </script>
    <script src="/js/dashboard.js"></script>
}