@model Transportation_System.Models.Domain.Route
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" id="editForm" class="ajax-form">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label fw-semibold text-muted">ID</label>
        <input type="text" class="form-control" value="@Model.Id" readonly disabled />
    </div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label fw-semibold">
            <i class="bi bi-tag me-1 text-primary"></i>Route Name
        </label>
        <input asp-for="Name" class="form-control"/>
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label fw-semibold">
            <i class="bi bi-card-text me-1 text-primary"></i>Description
        </label>
        <input asp-for="Description" class="form-control"/>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <div class="form-check form-switch">
            <input type="checkbox" class="form-check-input" asp-for="IsActive"/>
            <label class="form-check-label fw-semibold" asp-for="IsActive">
                <i class="bi bi-check-circle me-1 text-success"></i>Active
            </label>
        </div>
    </div>

    <hr class="my-3">

    <h6 class="text-muted text-uppercase small fw-bold mb-2">
        <i class="bi bi-list-ol me-1"></i>Stops (in order)
    </h6>

    <ul id="stopQueue" class="list-group mb-2" data-route-id="@Model.Id">
        @{ var stops = (List<Transportation_System.Models.Domain.Stop>)ViewBag.OrderedStops; }
        @for (int i = 0; i < stops.Count; i++)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center" data-stop-id="@stops[i].Id">
                <span><span class="text-muted me-2">@(i + 1).</span>@stops[i].Name</span>
                <div class="btn-group btn-group-sm">
                    <button type="button" class="btn btn-outline-secondary move-up" @(i == 0 ? "disabled" : "")>
                        <i class="bi bi-arrow-up"></i>
                    </button>
                    <button type="button" class="btn btn-outline-secondary move-down" @(i == stops.Count - 1 ? "disabled" : "")>
                        <i class="bi bi-arrow-down"></i>
                    </button>
                    <button type="button" class="btn btn-outline-danger remove-stop">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </li>
        }
        @if (!stops.Any())
        {
            <li class="list-group-item text-muted" id="emptyStopMessage">No stops on this route yet.</li>
        }
    </ul>
    
    <div id="routeStopsInputs">
        @foreach (var stop in stops)
        {
            <input type="hidden" name="RouteStops" value="@stop.Id" />
        }
    </div>
    <div id="deletedStop"></div>
    
    <div class="d-flex justify-content-end gap-2 mt-4 pt-2 border-top">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
            <i class="bi bi-x-lg me-1"></i>Cancel
        </button>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i>Save
        </button>
    </div>
</form>

