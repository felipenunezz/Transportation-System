@model Transportation_System.Models.Domain.BusStop
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Edit";
}

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" id="editForm" class="ajax-form">
    @Html.AntiForgeryToken()
    
    <div class="mb-3">
        <label class="form-label fw-semibold text-muted">ID</label>
        <input type="text" class="form-control" value="@Model.Id" readonly disabled />
    </div>

    <hr class="my-3">

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Name" class="form-label fw-semibold">
                <i class="bi bi-tag me-1 text-primary"></i>Stop Name
            </label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Address" class="form-label fw-semibold">
                <i class="bi bi-geo-alt me-1 text-primary"></i>Address
            </label>
            <input asp-for="Address" class="form-control"/>
            <span asp-validation-for="Address" class="text-danger small"></span>
        </div>
    </div>

    <hr class="my-3">
    
    <h6 class="text-muted text-uppercase small fw-bold mb-2">
        <i class="bi bi-geo-alt me-1"></i>Location
    </h6>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Latitude" class="form-label fw-semibold">Latitude</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-globe"></i></span>
                <input asp-for="Latitude" class="form-control"/>
            </div>
            <span asp-validation-for="Latitude" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Longitude" class="form-label fw-semibold">Longitude</label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-globe"></i></span>
                <input asp-for="Longitude" class="form-control"/>
            </div>
            <span asp-validation-for="Longitude" class="text-danger small"></span>
        </div>
    </div>
    
    <hr class="my-3">

    <h6 class="text-muted text-uppercase small fw-bold mb-2">
        <i class="bi bi-list-ol me-1"></i>Details
    </h6>
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="WaitingPassengers" class="form-label fw-semibold">
                <i class="bi bi-people me-1 text-success"></i>Waiting
            </label>
            <input asp-for="WaitingPassengers" class="form-control"/>
            <span asp-validation-for="WaitingPassengers" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="StopOrder" class="form-label fw-semibold">
                <i class="bi bi-sort-numeric-down me-1 text-success"></i>Order
            </label>
            <input asp-for="StopOrder" class="form-control"/>
            <span asp-validation-for="StopOrder" class="text-danger small"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="BusRouteId" class="form-label fw-semibold">
                <i class="bi bi-signpost-2 me-1 text-warning"></i>Route
            </label>
            <select asp-for="BusRouteId" class="form-select" asp-items="ViewBag.BusRouteId">
            </select>
            <span asp-validation-for="BusRouteId" class="text-danger small"></span>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4 pt-2 border-top">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
            <i class="bi bi-x-lg me-1"></i>Cancel
        </button>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i>Save
        </button>
    </div>
</form>