@using Transportation_System.Models.Domain
@model Transportation_System.Models.Domain.Stop
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Edit";
}

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" id="editForm" class="ajax-form">
    @Html.AntiForgeryToken()
    
    <div class="mb-3">
        <label class="form-label fw-semibold text-muted">ID</label>
        <input type="text" class="form-control" value="@Model.Id" readonly disabled />
    </div>

    <hr class="my-3">

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Name" class="form-label fw-semibold">
                <i class="bi bi-tag me-1 text-primary"></i>Stop Name
            </label>
            <input asp-for="Name" class="form-control" readonly="@(Model.Type == StopType.Depot)"/>
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="Address" class="form-label fw-semibold">
                <i class="bi bi-geo-alt me-1 text-primary"></i>Address
            </label>
            <input asp-for="Address" class="form-control" readonly="@(Model.Type == StopType.Depot)"/>
            <span asp-validation-for="Address" class="text-danger small"></span>
        </div>
    </div>

    <hr class="my-3">
    
    <h6 class="text-muted text-uppercase small fw-bold mb-2">
        <i class="bi bi-geo-alt me-1"></i>Location
    </h6>
    
    <input type="hidden" asp-for="Latitude" id="Latitude"/>
    <input type="hidden" asp-for="Longitude" id="Longitude"/>

    <div id="selectionMap" style="height: 250px; border-radius: 0.375rem; z-index: 0;" data-enable-selection="@(Model.Type == StopType.Depot ? "false" : "true")"></div>
    <div class="form-text text-muted mt-1">
        Lat: <span id="displayLat">--</span>, Lng: <span id="displayLng">--</span>
    </div>
    <span asp-validation-for="Latitude" class="text-danger small"></span>
    <span asp-validation-for="Longitude" class="text-danger small"></span>
    
    @if (Model.Type != StopType.Depot) {
        <hr class="my-3">

        <h6 class="text-muted text-uppercase small fw-bold mb-2">
            <i class="bi bi-list-ol me-1"></i>Details
        </h6>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="WaitingPassengers" class="form-label fw-semibold">
                    <i class="bi bi-people me-1 text-success"></i>Waiting
                </label>
                <input asp-for="WaitingPassengers" class="form-control"/>
                <span asp-validation-for="WaitingPassengers" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="RouteId" class="form-label fw-semibold" >
                    <i class="bi bi-signpost-2 me-1 text-warning"></i>Route
                </label>
                <select asp-for="RouteId" class="form-select" asp-items="ViewBag.RouteId">
                </select>
                <span asp-validation-for="RouteId" class="text-danger small"></span>
            </div>
        </div>
    }
    <input type="hidden" asp-for="Type" />
    
    <div class="d-flex justify-content-end gap-2 mt-4 pt-2 border-top">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
            <i class="bi bi-x-lg me-1"></i>Cancel
        </button>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i>Save
        </button>
    </div>
</form>