@using Transportation_System.Models.Domain
@model Transportation_System.Models.Domain.Bus
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Edit";
}

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" id="editForm" class="ajax-form">
    @Html.AntiForgeryToken()
    
    <div class="mb-3">
        <label class="form-label fw-semibold text-muted">ID</label>
        <input type="text" class="form-control" value="@Model.Id" readonly disabled />
    </div>

    <hr class="my-3">

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="BusNumber" class="form-label fw-semibold">
                <i class="bi bi-hash me-1 text-primary"></i>Bus Number
            </label>
            <input asp-for="BusNumber" class="form-control"/>
            <span asp-validation-for="BusNumber" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="RouteId" class="form-label fw-semibold">
                <i class="bi bi-signpost-2 me-1 text-primary"></i>Route
            </label>
            <select asp-for="RouteId" class="form-select" asp-items="ViewBag.RouteId">
                <option value="" disabled selected>-- Select Route --</option>
            </select>
            <span asp-validation-for="RouteId" class="text-danger small"></span>
        </div>
    </div>

    <hr class="my-3">

    <h6 class="text-muted text-uppercase small fw-bold mb-2">
        <i class="bi bi-geo-alt me-1"></i>Location
    </h6>
    
    <div class="col-md-6">
        <label asp-for="StopId" class="form-label fw-semibold">
            <i class="bi bi-geo-fill me-1 text-primary"></i>Stop
        </label>
        <select asp-for="StopId" class="form-select" asp-items="ViewBag.StopId">
            <option value="" disabled selected>-- Select Stop --</option>
        </select>
        <span asp-validation-for="StopId" class="text-danger small"></span>
    </div>

    <hr class="my-3">

    <h6 class="text-muted text-uppercase small fw-bold mb-2">
        <i class="bi bi-activity me-1"></i>Metrics
    </h6>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Speed" class="form-label fw-semibold">
                <i class="bi bi-speedometer2 me-1 text-success"></i>Speed (km/h)
            </label>
            <input asp-for="Speed" class="form-control"/>
            <span asp-validation-for="Speed" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="PassengerCount" class="form-label fw-semibold">
                <i class="bi bi-people me-1 text-success"></i>Passengers
            </label>
            <input asp-for="PassengerCount" class="form-control"/>
            <span asp-validation-for="PassengerCount" class="text-danger small"></span>
        </div>
    </div>

    <hr class="my-3">

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Status" class="form-label fw-semibold">
                <i class="bi bi-circle-fill me-1 text-warning"></i>Status
            </label>
            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<BusStatus>()">
                <option value="" disabled selected>-- Select Status --</option>
            </select>
            <span asp-validation-for="Status" class="text-danger small"></span>
        </div>
    </div>
    
    <div class="row g-6">
        <div class="form-check form-switch">
            <input type="checkbox" class="form-check-input" asp-for="OnRoute"/>
            <label class="form-check-label fw-semibold" asp-for="OnRoute">
                <i class="bi bi-check-circle me-1 text-success"></i>On Route
            </label>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4 pt-2 border-top">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
            <i class="bi bi-x-lg me-1"></i>Cancel
        </button>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i>Create Bus
        </button>
    </div>
</form>
